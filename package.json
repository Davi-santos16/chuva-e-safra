{
  "name": "projeto-chuva-e-safra",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
     "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w web\" \"npm run dev -w backend\"",
    "dev:web": "npm run dev -w web",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build -w web && npm run build -w backend",
    "build:web": "npm run build -w web",
    "build:backend": "npm run build -w backend",
    "start:backend": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
